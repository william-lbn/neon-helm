{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "runtime",
    "service",
    "placement"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": [
        "reference"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^[a-z0-9./:_-]+@sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent"
          ]
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "image",
            "host-binary"
          ]
        },
        "binaryHostPath": {
          "type": "string"
        },
        "binarySha256": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort"
          ]
        },
        "nodePort": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 32767
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "resources": {
      "type": "object",
      "additionalProperties": true
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedNodeNames"
      ],
      "properties": {
        "allowedNodeNames": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "worker-117",
              "worker-118",
              "worker-119"
            ]
          },
          "description": "本轮用户明确允许的三个节点；不得按节点角色推断或包含 ubuntu/116。"
        }
      }
    },
    "dsga": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "agentNamespace",
        "agentServiceAccount",
        "tlsSecret"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "agentNamespace": {
          "type": "string"
        },
        "agentServiceAccount": {
          "type": "string"
        },
        "tlsSecret": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
