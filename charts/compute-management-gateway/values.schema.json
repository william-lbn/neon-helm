{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "runtime",
    "service",
    "placement"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": [
        "reference"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^[a-z0-9./:_-]+@sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent"
          ]
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "image",
            "host-binary"
          ]
        },
        "binaryHostPath": {
          "type": "string"
        },
        "binarySha256": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort"
          ]
        },
        "nodePort": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 32767
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "resources": {
      "type": "object",
      "additionalProperties": true
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedNodeNames"
      ],
      "properties": {
        "allowedNodeNames": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          },
          "description": "Explicit Kubernetes hostnames that may run this chart. Site overlays replace the laboratory defaults."
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "matchExpressions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "operator"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "enum": [
                  "In",
                  "NotIn",
                  "Exists",
                  "DoesNotExist",
                  "Gt",
                  "Lt"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "dsga": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "agentNamespace",
        "agentServiceAccount",
        "tlsSecret"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "agentNamespace": {
          "type": "string"
        },
        "agentServiceAccount": {
          "type": "string"
        },
        "pki": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "selfSignedIssuerName": {"type": "string"},
            "rootCertificateName": {"type": "string"},
            "rootSecretName": {"type": "string"},
            "caIssuerName": {"type": "string"},
            "certificateName": {"type": "string"},
            "agentCASecret": {"type": "string"},
            "agentCABundle": {"type": "string"}
          }
        },
        "tlsSecret": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
