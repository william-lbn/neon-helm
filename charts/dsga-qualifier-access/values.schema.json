{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "configSecretName",
    "nodeName"
  ],
  "properties": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "name"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "configSecretName": {
      "type": "string",
      "pattern": "^cp-[a-f0-9]{16}-config$",
      "maxLength": 63
    },
    "nodeName": {
      "type": "string",
      "enum": [
        "worker-117",
        "worker-118",
        "worker-119"
      ]
    }
  }
}
