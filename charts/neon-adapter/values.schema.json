{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "compatibilityAcknowledged": {
      "type": "boolean"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "proxyTokenSecret": {
      "type": "string"
    },
    "hookTokenSecret": {
      "type": "string"
    },
    "routesSecret": {
      "type": "string"
    },
    "notificationsConfigMap": {
      "type": "string"
    },
    "priorityClassName": {
      "type": "string"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": true
        },
        "limits": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 0
        },
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": true
    },
    "nameOverride": {
      "type": "string"
    },
    "wakeTimeout": {
      "type": "string",
      "pattern": "^([1-9][0-9]?|[12][0-9]{2}|300)s$"
    },
    "maxConcurrentWakes": {
      "type": "integer",
      "maximum": 64,
      "minimum": 1
    },
    "pageserverNodeID": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedNodeNames"
      ],
      "properties": {
        "allowedNodeNames": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "worker-117",
              "worker-118",
              "worker-119"
            ]
          },
          "description": "本轮用户明确允许的三个节点；不得按节点角色推断或包含 ubuntu/116。"
        }
      }
    },
    "managedRuntimeRead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "computes"
      ],
      "properties": {
        "computes": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serviceName",
              "configSecretName"
            ],
            "properties": {
              "serviceName": {
                "type": "string",
                "pattern": "^cp-[a-f0-9]{16}$"
              },
              "configSecretName": {
                "type": "string",
                "pattern": "^cp-[a-f0-9]{16}-config$"
              }
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "neon-adapter values",
  "required": [
    "placement"
  ]
}
