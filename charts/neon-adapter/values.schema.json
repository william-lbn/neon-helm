{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "compatibilityAcknowledged": {
      "type": "boolean"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "proxyTokenSecret": {
      "type": "string"
    },
    "hookTokenSecret": {
      "type": "string"
    },
    "routesSecret": {
      "type": "string"
    },
    "notificationsConfigMap": {
      "type": "string"
    },
    "priorityClassName": {
      "type": "string"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": true
        },
        "limits": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 0
        },
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": true
    },
    "nameOverride": {
      "type": "string"
    },
    "wakeTimeout": {
      "type": "string",
      "pattern": "^([1-9][0-9]?|[12][0-9]{2}|300)s$"
    },
    "maxConcurrentWakes": {
      "type": "integer",
      "maximum": 64,
      "minimum": 1
    },
    "pageserverNodeID": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "neon-adapter values"
}
