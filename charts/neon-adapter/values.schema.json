{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "compatibilityAcknowledged": {
      "type": "boolean"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "proxyTokenSecret": {
      "type": "string"
    },
    "hookTokenSecret": {
      "type": "string"
    },
    "routesSecret": {
      "type": "string"
    },
    "notificationsConfigMap": {
      "type": "string"
    },
    "priorityClassName": {
      "type": "string"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": true
        },
        "limits": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 0
        },
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": true
    },
    "nameOverride": {
      "type": "string"
    },
    "wakeTimeout": {
      "type": "string",
      "pattern": "^([1-9][0-9]?|[12][0-9]{2}|300)s$"
    },
    "maxConcurrentWakes": {
      "type": "integer",
      "maximum": 64,
      "minimum": 1
    },
    "pageserverNodeID": {
      "type": "integer",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedNodeNames"
      ],
      "properties": {
        "allowedNodeNames": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "worker-117",
              "worker-118",
              "worker-119"
            ]
          },
          "description": "\u672c\u8f6e\u7528\u6237\u660e\u786e\u5141\u8bb8\u7684\u4e09\u4e2a\u8282\u70b9\uff1b\u4e0d\u5f97\u6309\u8282\u70b9\u89d2\u8272\u63a8\u65ad\u6216\u5305\u542b ubuntu/116\u3002"
        }
      }
    },
    "managedRuntimeRead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "computes"
      ],
      "properties": {
        "computes": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serviceName",
              "configSecretName"
            ],
            "properties": {
              "serviceName": {
                "type": "string",
                "pattern": "^cp-[a-f0-9]{16}$"
              },
              "configSecretName": {
                "type": "string",
                "pattern": "^cp-[a-f0-9]{16}-config$"
              }
            }
          }
        }
      }
    },
    "storageManagement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "profile"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol_version": {
              "const": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "service_name": {
              "type": "string",
              "minLength": 1
            },
            "service_uid": {
              "type": "string",
              "minLength": 1
            },
            "credential_secret_name": {
              "type": "string",
              "minLength": 1
            },
            "credential_secret_uid": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "profile": {
                "required": [
                  "protocol_version",
                  "service_name",
                  "service_uid",
                  "port",
                  "credential_secret_name",
                  "credential_secret_uid"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "neon-adapter values",
  "required": [
    "placement"
  ]
}
