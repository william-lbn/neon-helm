{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "experimentalAcknowledged": {
      "type": "boolean"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedKubernetesMinor": {
          "type": "string"
        },
        "allowUntestedKubernetes": {
          "type": "boolean"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scheduler": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object",
          "additionalProperties": true
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kubernetes.io/hostname": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
            }
          },
          "description": "只允许三worker中的额外hostname，不得覆盖固定pool/os/arch。"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedNodeNames"
      ],
      "properties": {
        "allowedNodeNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          },
          "description": "Explicit Kubernetes hostnames that may run this chart. Site overlays replace the laboratory defaults."
        }
      }
    },
    "dsga": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "pgVersion",
        "vmNamespace",
        "hostIdentities",
        "agent",
        "scheduler"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "pgVersion": {
          "type": "integer",
          "const": 17
        },
        "vmNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gatewayURL",
            "managementCASecret",
            "managementCAKey",
            "tokenAudience",
            "tokenExpirationSeconds",
            "requestTimeoutSeconds",
            "computeTimeoutSeconds",
            "pollIntervalSeconds",
            "prepareQualifications",
            "automaticMemory"
          ],
          "properties": {
            "gatewayURL": {
              "type": "string"
            },
            "managementCASecret": {
              "type": "string"
            },
            "managementCAKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "tokenAudience": {
              "const": "neon-dsga-credential-broker"
            },
            "tokenExpirationSeconds": {
              "type": "integer",
              "minimum": 600,
              "maximum": 3600
            },
            "requestTimeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "computeTimeoutSeconds": {
              "type": "integer",
              "minimum": 90,
              "maximum": 120
            },
            "pollIntervalSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "prepareQualifications": {
              "type": "object",
              "maxProperties": 128,
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "claim",
                  "sha256"
                ],
                "properties": {
                  "claim": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "uid"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                      },
                      "uid": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
                      }
                    }
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            },
            "cacheShadow": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tenantId",
                  "timelineId",
                  "sampleIntervalSeconds",
                  "maximumSampleAgeSeconds",
                  "minimumWindowMinutes",
                  "slopeWindowMinutes",
                  "maximumSlopeIncrease"
                ],
                "properties": {
                  "tenantId": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{32}$"
                  },
                  "timelineId": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{32}$"
                  },
                  "sampleIntervalSeconds": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 60
                  },
                  "maximumSampleAgeSeconds": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 300
                  },
                  "minimumWindowMinutes": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 60
                  },
                  "slopeWindowMinutes": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 30
                  },
                  "maximumSlopeIncrease": {
                    "type": "number",
                    "exclusiveMinimum": 1
                  }
                }
              }
            },
            "automaticMemory": {
              "type": "object",
              "maxProperties": 128,
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "targets",
                  "sampleIntervalSeconds",
                  "maximumSampleGapSeconds",
                  "growWindowSeconds",
                  "shrinkWindowSeconds",
                  "cooldownSeconds",
                  "requestDeadlineSeconds",
                  "shrinkThresholdPermille",
                  "growThresholdPermille",
                  "emergencyThresholdPermille"
                ],
                "properties": {
                  "targets": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 32,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "vmMemoryBytes",
                        "buffers"
                      ],
                      "properties": {
                        "vmMemoryBytes": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]{0,19}$",
                          "maxLength": 20
                        },
                        "buffers": {
                          "type": "integer",
                          "minimum": 16,
                          "maximum": 1073741823
                        }
                      }
                    }
                  },
                  "sampleIntervalSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  },
                  "maximumSampleGapSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 300
                  },
                  "growWindowSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600
                  },
                  "shrinkWindowSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400
                  },
                  "cooldownSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400
                  },
                  "requestDeadlineSeconds": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 3600
                  },
                  "shrinkThresholdPermille": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 998
                  },
                  "growThresholdPermille": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 999
                  },
                  "emergencyThresholdPermille": {
                    "type": "integer",
                    "minimum": 3,
                    "maximum": 1000
                  },
                  "minimumVMMemoryBytes": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$",
                    "maxLength": 20
                  },
                  "maximumVMMemoryBytes": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$",
                    "maxLength": 20
                  }
                }
              }
            },
            "resourceReadSocket": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "hostDirectory",
                "mountDirectory",
                "name"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "hostDirectory": {
                  "type": "string"
                },
                "mountDirectory": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            "controlSocket": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "hostDirectory",
                "mountDirectory",
                "name"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "hostDirectory": {
                  "type": "string"
                },
                "mountDirectory": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "description": "独立完整Owner管理UDS，默认关闭。仅/run/neon-dsga-*私有目录，与resourceReadSocket目录不可相同或嵌套；不新增网络服务。"
            },
            "runtimeSelectionNamespace": {
              "type": "string",
              "pattern": "^$|^neon-control-[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 63
            }
          }
        },
        "scheduler": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodes"
          ],
          "properties": {
            "nodes": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "binding",
                  "profile",
                  "system_bytes"
                ],
                "properties": {
                  "binding": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "node_name",
                      "node_uid",
                      "namespace",
                      "lease_name",
                      "lease_uid"
                    ],
                    "properties": {
                      "node_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
                      },
                      "node_uid": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
                      },
                      "namespace": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63,
                        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                      },
                      "lease_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                      },
                      "lease_uid": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
                      }
                    }
                  },
                  "profile": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "scheduler_name",
                      "vm_overhead_bytes",
                      "pod_overhead_bytes"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                      },
                      "scheduler_name": {
                        "const": "autoscale-scheduler"
                      },
                      "vm_overhead_bytes": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,19}$",
                        "maxLength": 20
                      },
                      "pod_overhead_bytes": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,19}$",
                        "maxLength": 20
                      }
                    }
                  },
                  "system_bytes": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$",
                    "maxLength": 20
                  },
                  "initialize_at_resource_version": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "kubernetes_budget": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "protocol_version",
                      "scope",
                      "node_name",
                      "node_uid",
                      "capacity_bytes",
                      "allocatable_bytes",
                      "system_reservation_bytes",
                      "profile_sha256"
                    ],
                    "properties": {
                      "protocol_version": {
                        "const": 1
                      },
                      "scope": {
                        "const": "kubernetes-node-memory-budget-v1"
                      },
                      "node_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
                      },
                      "node_uid": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
                      },
                      "capacity_bytes": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,19}$",
                        "maxLength": 20
                      },
                      "allocatable_bytes": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,19}$",
                        "maxLength": 20
                      },
                      "system_reservation_bytes": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,19}$",
                        "maxLength": 20
                      },
                      "profile_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                }
              }
            },
            "podProtectionNamespaces": {
              "type": "array",
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "kube-system",
                  "neon-cert-manager",
                  "neonvm-system",
                  "neon-control-runtime"
                ]
              },
              "description": "仅显式白名单namespace的Pod get/patch；neon旧Role不变，不创建全局Pod写权限。"
            },
            "ordinaryStopSourceNames": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
              },
              "description": "仅kube-system内运维者本轮实际发布并读回的普通Pod停止来源CM精确名称；仅get，不授list/watch/write。名称和Node ownerRef不能单独认证内容。"
            }
          }
        },
        "hostIdentities": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "description": "Explicit site hostname to observed immutable Node UID map; no historical fallback. Host domains must cover this map exactly."
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "neon-autoscaler values",
  "required": [
    "placement",
    "dsga"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "dsga": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "dsga": {
            "properties": {
              "hostIdentities": {
                "minProperties": 1
              },
              "agent": {
                "properties": {
                  "gatewayURL": {
                    "pattern": "^https://[A-Za-z0-9.-]+(:[1-9][0-9]{0,4})?/?$"
                  },
                  "managementCASecret": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                  }
                }
              },
              "scheduler": {
                "properties": {
                  "nodes": {
                    "minItems": 1,
                    "maxItems": 16
                  },
                  "podProtectionNamespaces": {
                    "allOf": [
                      {
                        "contains": {
                          "const": "kube-system"
                        }
                      },
                      {
                        "contains": {
                          "const": "neon-cert-manager"
                        }
                      },
                      {
                        "contains": {
                          "const": "neonvm-system"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
