{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "experimentalAcknowledged": {
      "type": "boolean"
    },
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "timelineId": {
          "type": "string"
        },
        "existingConfigSecret": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "rootDiskSize": {
          "type": "string"
        },
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "use": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "slotSize": {
              "type": "string"
            },
            "minSlots": {
              "type": "integer",
              "minimum": 0
            },
            "useSlots": {
              "type": "integer",
              "minimum": 0
            },
            "maxSlots": {
              "type": "integer",
              "minimum": 0
            },
            "minBound": {
              "type": "string"
            },
            "maxBound": {
              "type": "string"
            }
          }
        },
        "pgVersion": {
          "type": "integer",
          "enum": [
            17
          ]
        }
      },
      "required": [
        "pgVersion"
      ]
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedNodeNames"
      ],
      "properties": {
        "allowedNodeNames": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "worker-117",
              "worker-118",
              "worker-119"
            ]
          },
          "description": "本轮用户明确允许的三个节点；不得按节点角色推断或包含 ubuntu/116。"
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "neon-compute values",
  "required": [
    "placement"
  ]
}
