{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "experimentalAcknowledged": {
      "type": "boolean"
    },
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "timelineId": {
          "type": "string"
        },
        "existingConfigSecret": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "rootDiskSize": {
          "type": "string"
        },
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "use": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "slotSize": {
              "type": "string"
            },
            "minSlots": {
              "type": "integer",
              "minimum": 0
            },
            "useSlots": {
              "type": "integer",
              "minimum": 0
            },
            "maxSlots": {
              "type": "integer",
              "minimum": 0
            },
            "minBound": {
              "type": "string"
            },
            "maxBound": {
              "type": "string"
            }
          }
        },
        "pgVersion": {
          "type": "integer",
          "enum": [
            17,
            18
          ]
        },
        "startupMode": {
          "type": "string",
          "enum": [
            "legacy",
            "trusted-runtime-v1"
          ]
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executionModel": {
              "type": "string"
            },
            "incarnation": {
              "type": "string"
            },
            "computeInstanceId": {
              "type": "string"
            },
            "runnerImage": {
              "type": "string"
            },
            "kernelImage": {
              "type": "string"
            },
            "serviceAccountName": {
              "type": "string"
            },
            "configMountPath": {
              "type": "string"
            },
            "configFile": {
              "type": "string"
            },
            "postgresPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "projectId": {
              "type": "string",
              "maxLength": 63
            },
            "endpointId": {
              "type": "string"
            },
            "podResources": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cpu": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*m?$"
                    },
                    "memory": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|Pi|Ei)?$"
                    }
                  }
                },
                "requests": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cpu": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*m?$"
                    },
                    "memory": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|Pi|Ei)?$"
                    }
                  }
                }
              },
              "description": "\u663e\u5f0fRunner CPU/\u5185\u5b58\u9884\u7b97\uff1b\u5185\u7f6e\u590d\u5236init\u6cbf\u6b63\u5f0fController\u7ee7\u627f\u540c\u9650\u989d\uff0c\u8bbe\u5907\u4e0d\u590d\u5236\u3002"
            }
          }
        }
      },
      "required": [
        "pgVersion"
      ]
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedNodeNames"
      ],
      "properties": {
        "allowedNodeNames": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "worker-117",
              "worker-118",
              "worker-119"
            ]
          },
          "description": "\u672c\u8f6e\u7528\u6237\u660e\u786e\u5141\u8bb8\u7684\u4e09\u4e2a\u8282\u70b9\uff1b\u4e0d\u5f97\u6309\u8282\u70b9\u89d2\u8272\u63a8\u65ad\u6216\u5305\u542b ubuntu/116\u3002"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secondary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "neon-compute values",
  "required": [
    "placement"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "compute": {
            "properties": {
              "enabled": {
                "const": true
              },
              "startupMode": {
                "const": "trusted-runtime-v1"
              }
            },
            "required": [
              "enabled",
              "startupMode"
            ]
          }
        },
        "required": [
          "compute"
        ]
      },
      "then": {
        "properties": {
          "compute": {
            "properties": {
              "runtime": {
                "properties": {
                  "podResources": {
                    "required": [
                      "limits"
                    ],
                    "properties": {
                      "limits": {
                        "required": [
                          "cpu",
                          "memory"
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "podResources"
                ]
              }
            },
            "required": [
              "runtime"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "compute": {
            "properties": {
              "pgVersion": {
                "const": 18
              }
            },
            "required": [
              "pgVersion"
            ]
          }
        },
        "required": [
          "compute"
        ]
      },
      "then": {
        "properties": {
          "compute": {
            "properties": {
              "startupMode": {
                "const": "trusted-runtime-v1"
              }
            },
            "required": [
              "startupMode"
            ]
          }
        }
      }
    }
  ]
}
