            },
            "existingSecret": {
              "type": "string",
              "pattern": "^$|^[a-z0-9][a-z0-9.-]{0,252}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "existingSecret": {
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
