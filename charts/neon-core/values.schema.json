                    },
                    {
                      "type": "string",
                      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)(?:[EPTGMK]i|[eE][+-]?[0-9]+|[EPTGMkKmun])?$"
