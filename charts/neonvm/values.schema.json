{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "experimentalAcknowledged": {
      "type": "boolean"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedKubernetesMinor": {
          "type": "string"
        },
        "allowUntestedKubernetes": {
          "type": "boolean"
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qemuDiskCacheSettings": {
          "type": "string"
        },
        "labAcknowledged": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "spreadAcrossNodes": {
          "type": "boolean"
        },
        "priorityClassName": {
          "type": "string"
        },
        "apiClient": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "qps": {
              "type": "integer",
              "minimum": 0
            },
            "burst": {
              "type": "integer",
              "minimum": 0
            },
            "concurrency": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": true
            },
            "limits": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSurge": {
              "type": "integer",
              "minimum": 0
            },
            "maxUnavailable": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "runnerCgroupEnabled": {
          "type": "boolean",
          "description": "Enable native runner cgroup management; false explicitly preserves historical dummy/laboratory mode and cannot qualify fractional CPU."
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kubernetes.io/hostname": {
              "type": "string",
              "enum": [
                "worker-117",
                "worker-118",
                "worker-119"
              ]
            }
          },
          "description": "只允许三worker中的额外hostname；固定pool/os/arch由模板保留，禁止覆盖。"
        },
        "managedMemoryRetirement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "namespaces"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespaces": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 63,
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "namespaces": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podRange": {
          "type": "string"
        },
        "podRangeStart": {
          "type": "string"
        },
        "podRangeEnd": {
          "type": "string"
        },
        "vmRange": {
          "type": "string"
        },
        "vmRangeStart": {
          "type": "string"
        },
        "secondary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "description": "显式false只省略额外NAD/VXLAN，不更改现有Cilium/宿主CNI；Controller启动IPAM配置仍保留。"
        }
      }
    },
    "platformPriority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controller": {
          "type": "string"
        },
        "runner": {
          "type": "string"
        },
        "vxlanController": {
          "type": "string"
        },
        "devicePlugin": {
          "type": "string",
          "pattern": "^[^\\s]+@sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "devicePlugin"
      ]
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedNodeNames"
      ],
      "properties": {
        "allowedNodeNames": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "worker-117",
              "worker-118",
              "worker-119"
            ]
          },
          "description": "本轮用户明确允许的三个节点；不得按节点角色推断或包含 ubuntu/116。"
        }
      }
    },
    "vxlanController": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initResources"
      ],
      "properties": {
        "initResources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": true
            },
            "limits": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "memory"
              ],
              "properties": {
                "memory": {
                  "anyOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)(?:[EPTGMK]i|[eE][+-]?[0-9]+|[EPTGMkKmun])?$"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "neonvm values",
  "required": [
    "placement"
  ]
}
